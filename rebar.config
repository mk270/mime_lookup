{erl_opts, [debug_info]}.
{deps, []}.

{shell, [
  % {config, "config/sys.config"},
    {apps, [mime_lookup]}
]}.

% eunit.hrl adds a test/0 that calls eunit:test/1, so eunit must be in the PLT.
{dialyzer, [{plt_extra_apps, [eunit]}]}.

{minimum_otp_vsn, "27"}.

{project_plugins, [rebar3_ex_doc]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{ex_doc, [
    {extras, ["README.md", "LICENCE"]},
    {main, "README.md"},
    {source_url, "https://github.com/mk270/mime_lookup"}
]}.

